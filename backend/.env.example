# Copy this file to .env and fill in your values. Never commit .env to Git.

# Required — get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — AI models (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b

# Optional — free Google Fact Check Tools API key for extra published fact-checks
# https://developers.google.com/fact-check/tools/api
# FACTCHECK_API_KEY=

# Set to "production" on your live server
# APP_ENV=development

# Requests allowed per visitor IP (Flask-Limiter syntax)
# RATE_LIMIT=8 per minute;80 per day

# Only if your frontend is hosted on a different domain, e.g. https://myapp.vercel.app
# ALLOWED_ORIGINS=

# Behind a proxy (Render/Railway/Nginx) keep this 1 so rate limits see the real visitor IP
# TRUST_PROXY=1

# CACHE_TTL_SECONDS=21600
# MAX_TEXT_LENGTH=5000
